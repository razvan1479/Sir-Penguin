# Copiază fișierul ca .env și completează valorile. .env NU se urcă pe GitHub.

# Din Discord Developer Portal -> aplicația Discord Community Manager -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Text random lung. Generezi unul cu:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Token secret partajat cu dashboard-ul Sir Penguin (același text și în .env-ul botului,
# la LICENSE_ADMIN_TOKEN). Generezi la fel ca mai sus, alt text decât SESSION_SECRET.
INTERNAL_ADMIN_TOKEN=

# Redirect-ul folosit de aplicația desktop (trebuie trecut identic și în Developer Portal)
APP_REDIRECT_URIS=http://127.0.0.1:53134/callback

# Opționale
KEY_PREFIX=IDEAL
TIMEZONE=Europe/Bucharest

# Pagina de admin proprie (/admin). Implicit oprită: licențele le administrezi din dashboard-ul Sir Penguin.
# Dacă o pornești ca rezervă, completează și restul și adaugă PUBLIC_BASE_URL/admin/callback în Developer Portal.
WEB_ADMIN_ENABLED=false
PUBLIC_BASE_URL=https://licente.92-5-36-4.sslip.io
ADMIN_DISCORD_IDS=1493163753447882894
COOKIE_SECURE=true
